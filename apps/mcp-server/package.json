{
  "name": "@nullroot/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "NRDG Model Context Protocol server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@nullroot/core": "workspace:*",
    "@nullroot/knowledge": "workspace:*",
    "@nullroot/retrieval": "workspace:*",
    "@nullroot/compatibility": "workspace:*",
    "@nullroot/analyzers": "workspace:*",
    "@nullroot/integrations": "workspace:*",
    "@nullroot/config": "workspace:*",
    "@nullroot/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "vitest": {
    "passWithNoTests": true
  }
}