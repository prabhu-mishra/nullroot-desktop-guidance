{
  "name": "nullroot-desktop-guidance",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first developer intelligence platform for Linux desktop development",
  "license": "MIT",
  "author": "NullRoot",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "dev": "pnpm --filter @nullroot/cli run dev",
    "cli": "pnpm --filter @nullroot/cli run cli"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.15.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0"
  }
}